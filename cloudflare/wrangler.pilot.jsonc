{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "navigate-pathway-pilot-api",
  "main": "pilot-api.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true }
  },
  "vars": {
    "PILOT_ENVIRONMENT": "staging"
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "env": {
    "staging": {
      "name": "navigate-pathway-pilot-api-staging",
      "vars": { "PILOT_ENVIRONMENT": "staging" },
      "triggers": { "crons": ["*/15 * * * *"] },
      "secrets": {
        "required": [
          "SUPABASE_URL",
          "SUPABASE_ANON_KEY",
          "SUPABASE_SERVICE_ROLE_KEY",
          "ALLOWED_ORIGINS",
          "INVITE_REDIRECT_URL",
          "SURVEY_PRE_HEALTH",
          "SURVEY_GRIT",
          "SURVEY_IDENTITY",
          "SURVEY_RESILIENCE",
          "SURVEY_ACCS",
          "SURVEY_ENCRYPTION_KEY",
          "EVENT_SMS_WEBHOOK_SECRET",
          "CREATOR_BOOTSTRAP_EMAIL"
        ]
      }
    },
    "production": {
      "name": "navigate-pathway-pilot-api-production",
      "preview_urls": false,
      "vars": { "PILOT_ENVIRONMENT": "production" },
      "triggers": { "crons": ["*/15 * * * *"] },
      "secrets": {
        "required": [
          "SUPABASE_URL",
          "SUPABASE_ANON_KEY",
          "SUPABASE_SERVICE_ROLE_KEY",
          "EVENT_SMS_WEBHOOK_SECRET",
          "ALLOWED_ORIGINS",
          "INVITE_REDIRECT_URL",
          "CREATOR_BOOTSTRAP_EMAIL"
        ]
      }
    }
  }
}
